# API settings. Copy to api/.env (never commit it, never paste keys into a chat).
# Local values come from `supabase status` after `supabase start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only: moves files in private storage, never used for data
STORAGE_BACKEND=supabase
WEB_ORIGINS=http://localhost:3000
# Windows only: LibreOffice is not on the system path after install, so point to it.
# Leave unset on Railway, where the Dockerfile puts soffice on the path.
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe